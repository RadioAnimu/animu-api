{
  "name": "animu-api",
  "version": "1.0.0",
  "description": "TypeScript API client for Animu radio (Go SSE daemon at api.animu.moe/tungtungtung). Track metadata, programs, history, music requests, live requests, streams and auth.",
  "keywords": [
    "animu",
    "radio",
    "anime",
    "api",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ness.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadioAnimu/animu-api.git"
  },
  "homepage": "https://github.com/RadioAnimu/animu-api#readme",
  "bugs": {
    "url": "https://github.com/RadioAnimu/animu-api/issues"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run build:esm && pnpm run build:cjs && node scripts/check-package.mjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/rename-cjs.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "check:audit": "node scripts/check-dependency-audit.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:tooling": "node --test scripts/__tests__/*.test.mjs",
    "check:ci": "pnpm run check:secrets && pnpm run check:quality",
    "check:quality": "pnpm run test:tooling && pnpm run check:audit && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.34.6"
}
