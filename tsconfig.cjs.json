    "outDir": "dist/cjs",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src"
  ]
}
